<Project Sdk="Microsoft.NET.Sdk">
  <!-- Outlook-Plugin für Brim: E-Mails, Termine und Aufgaben aus Outlook (COM) in der Notch.
       Die Build-Ausgabe ist der fertige Plugin-Ordner. -->
  <PropertyGroup>
    <!-- Kein Konsolenfenster, wenn Brim das Plugin startet; stdout/stderr landen trotzdem im Plugin-Log. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>BrimOutlook</AssemblyName>
    <RootNamespace>BrimOutlook</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="BrimOutlook.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\external\brim\src\Brim.Sdk\Brim.Sdk.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
